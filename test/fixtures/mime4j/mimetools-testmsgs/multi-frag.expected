message
  header 5
  multipart
    preamble "The preamble of the outer multipart message.\r\nMail readers that understand multipart format\r\nshould ignore this preamble.\r\nIf you are reading this text, you might want to\r\nconsider changing to a mail reader that understands\r\nhow to properly display multipart messages."
    part
      header 0
      body "Part 1 of the outer message.\r\n[Note that the preceding blank line means\r\nno header fields were given and this is text,\r\nwith charset US ASCII.  It could have been\r\ndone with explicit typing as in the next part.]\r\n"
    part
      header 1
      body "Part 2 of the outer message.\r\nThis could have been part of the previous part,\r\nbut illustrates explicit versus implicit\r\ntyping of body parts.\r\n"
    part
      header 2
      multipart
        preamble "A one-line preamble for the inner multipart message."
